                            <Option name="properties" type="Map">
                              <Option name="enabled" type="Map">
                                <Option value="true" name="active" type="bool"/>
                                <Option value="(CASE WHEN @vector_tile_zoom >= 13 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,13,14,0,1)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN (scale_linear(@vector_tile_zoom,14,15,1,8)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_linear(@vector_tile_zoom,15,16,8,12)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,16,18,12,18)) * 0.264583 WHEN @vector_tile_zoom > 18 AND @vector_tile_zoom &lt;= 20 THEN (scale_linear(@vector_tile_zoom,18,20,18,36)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN 9.525 END) > 0" name="expression" type="QString"/>
                                <Option value="3" name="type" type="int"/>
                              </Option>
                              <Option name="outlineColor" type="Map">
                                <Option value="true" name="active" type="bool"/>
                                <Option value="set_color_part(@symbol_color, 'alpha', scale_linear(@vector_tile_zoom,13,14,0,255))" name="expression" type="QString"/>
                                <Option value="3" name="type" type="int"/>
                              </Option>
                              <Option name="outlineWidth" type="Map">
                                <Option value="true" name="active" type="bool"/>
                                <Option value="CASE WHEN @vector_tile_zoom >= 13 AND @vector_tile_zoom &lt;= 14 THEN (scale_linear(@vector_tile_zoom,13,14,0,1)) * 0.264583 WHEN @vector_tile_zoom > 14 AND @vector_tile_zoom &lt;= 15 THEN (scale_linear(@vector_tile_zoom,14,15,1,8)) * 0.264583 WHEN @vector_tile_zoom > 15 AND @vector_tile_zoom &lt;= 16 THEN (scale_linear(@vector_tile_zoom,15,16,8,12)) * 0.264583 WHEN @vector_tile_zoom > 16 AND @vector_tile_zoom &lt;= 18 THEN (scale_linear(@vector_tile_zoom,16,18,12,18)) * 0.264583 WHEN @vector_tile_zoom > 18 AND @vector_tile_zoom &lt;= 20 THEN (scale_linear(@vector_tile_zoom,18,20,18,36)) * 0.264583 WHEN @vector_tile_zoom > 20 THEN 9.525 END" name="expression" type="QString"/>
                                <Option value="3" name="type" type="int"/>
                              </Option>
                            </Option>
                            <Option value="collection" name="type" type="QString"/>
                          </Option>
                        </data_defined_properties>
